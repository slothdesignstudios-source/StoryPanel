    "w": 24,
    "x": 0,
    "y": 0
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Request rate by status",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(sp_http_requests_total[5m]))",
     "legendFormat": "{{status}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Latency p50 / p95",
   "datasource": {
