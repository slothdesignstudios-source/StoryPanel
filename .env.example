# Copy to .env. Placeholders only: never commit real values.
# Every setting is read by services/backend/src/storypanel/config.py (prefix SP_).

# --- environment
SP_ENV=local                      # local | test | staging | production
SP_RELEASE=dev
SP_PSEUDONYM_SALT=change-me       # required outside local/test

# --- data stores
SP_DATABASE_URL=postgresql+asyncpg://storypanel:storypanel@localhost:5432/storypanel
SP_REDIS_URL=redis://localhost:6379/0
SP_S3_ENDPOINT_URL=http://localhost:9000      # omit for AWS S3
SP_S3_REGION=us-east-1
SP_S3_BUCKET=storypanel-assets
SP_S3_ACCESS_KEY_ID=
SP_S3_SECRET_ACCESS_KEY=

# --- Temporal (Temporal Cloud: set address, namespace, API key and SP_TEMPORAL_TLS=true)
SP_TEMPORAL_ADDRESS=localhost:7233
SP_TEMPORAL_NAMESPACE=default
SP_TEMPORAL_API_KEY=
SP_TEMPORAL_TLS=false

# --- auth: "dev" is refused in staging/production
SP_AUTH_MODE=dev                  # dev | clerk
SP_CLERK_ISSUER=                  # https://<your-instance>.clerk.accounts.dev
SP_CLERK_JWKS_URL=                # <issuer>/.well-known/jwks.json
SP_CLERK_AUTHORIZED_PARTIES=[]    # ["https://app.example.com"]
SP_CLERK_WEBHOOK_SECRET=
SP_CORS_ORIGINS=["http://localhost:3000"]

# --- providers: "fake" is refused in staging/production
SP_PROVIDER_MODE=fake             # fake | live
# Secrets: server-side only (never NEXT_PUBLIC_*). Only the providers you enable need a key.
SP_ANTHROPIC_API_KEY=             # story, script, moderation, safety and layout vision checks
SP_OPENAI_API_KEY=                # OpenAI images (default image provider)
SP_GEMINI_API_KEY=                # Gemini visual identity QA, and Gemini images when chosen for a comic
# Model identifiers have NO defaults: set them after checking the provider's model list
# (docs/providers.md lists the verified choices and their sources).
SP_TEXT_MODEL_STORY=              # claude-sonnet-5-5
SP_TEXT_MODEL_LIGHT=              # claude-haiku-5-5
SP_VISION_MODEL=                  # claude-haiku-5-5
# Image providers a new comic may use; each comic keeps the one it was created with.
SP_IMAGE_PROVIDERS=["openai","gemini"]
SP_IMAGE_PROVIDER_DEFAULT=openai
SP_OPENAI_IMAGE_MODEL=            # gpt-image-2.5-sunburst
SP_OPENAI_IMAGE_QUALITY=medium    # low | medium | high
SP_GEMINI_IMAGE_MODEL=            # gemini-3.1-flash-image
SP_GEMINI_IMAGE_SIZE=1K           # 1K | 2K
SP_IMAGE_REQUEST_TIMEOUT_SECONDS=240   # a timed-out image call is never re-sent automatically
SP_IMAGE_MAX_REFERENCES=4
# Character consistency: gemini_visual (Gemini compares panels with the approved references)
SP_IDENTITY_QA=gemini_visual
SP_GEMINI_QA_MODEL=               # gemini-3.8-flash
# Exports resample locally (no external upscaler). "fal" needs SP_FAL_ENABLED=true.
SP_EXPORT_UPSCALE=local
SP_REPAIR_MODE=reference_edit     # instruction edit + local compositing (inpaint needs fal)

# --- optional, disabled: fal (images, mask inpainting, ESRGAN) and Voyage (embeddings).
# Their adapters are kept for later use; while disabled no key is needed and nothing calls them.
SP_FAL_ENABLED=false
SP_VOYAGE_ENABLED=false
SP_FAL_KEY=
SP_VOYAGE_API_KEY=
SP_IMAGE_MODEL_GENERATE=          # fal-ai/nano-banana-2
SP_IMAGE_MODEL_EDIT=              # fal-ai/nano-banana-2/edit
SP_IMAGE_MODEL_FALLBACK=
SP_IMAGE_MODEL_FALLBACK_GENERATE=
SP_INPAINT_MODEL=
SP_UPSCALE_MODEL=                 # fal-ai/esrgan (only with SP_EXPORT_UPSCALE=fal)
SP_EMBEDDING_MODEL=               # voyage-multimodal-3.5 (only with SP_IDENTITY_QA=voyage_embedding)
SP_EMBEDDING_DIMENSIONS=1024
# Provider prices: a JSON table with a source and verification date per model.
# Start from packages/pricing/pricing.example.json. Live mode refuses to start (and
# refuses billable calls) when a configured model has no entry, a zero price not marked
# "free", or an entry older than SP_PRICING_MAX_AGE_DAYS.
SP_PRICING_FILE=
SP_PRICING_JSON=                  # alternative to the file, for platforms without file mounts
SP_PRICING_MAX_AGE_DAYS=60
SP_COUNT_FAILED_REQUESTS_AS_BILLED=true
SP_SPEND_LIMIT_USER_DAILY_USD=10
SP_SPEND_LIMIT_PROJECT_USD=8
SP_SPEND_LIMIT_GLOBAL_DAILY_USD=500

# --- billing (Stripe)
SP_STRIPE_SECRET_KEY=
SP_STRIPE_WEBHOOK_SECRET=
SP_STRIPE_PRICE_CREATOR=
SP_STRIPE_PRICE_PRO=
SP_STRIPE_PRICE_CREDIT_PACK=
SP_WEB_BASE_URL=http://localhost:3000

# --- observability (all optional; generation never depends on them)
SP_OTLP_ENDPOINT=                 # http://otel-collector:4318
SP_TRACE_SAMPLE_RATIO=1.0
SP_SENTRY_DSN=
SP_LANGFUSE_PUBLIC_KEY=
SP_LANGFUSE_SECRET_KEY=
SP_LANGFUSE_HOST=
SP_LOG_PROMPTS=false              # keep false: raw prompts stay out of logs and traces

# --- web (compiled into the bundle at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_ASSET_ORIGINS=http://localhost:9000
NEXT_PUBLIC_SENTRY_DSN=
