# Copy to .env. Placeholders only: never commit real values.
# Every setting is read by services/backend/src/storypanel/config.py (prefix SP_).

# --- environment
SP_ENV=local                      # local | test | staging | production
SP_RELEASE=dev
SP_PSEUDONYM_SALT=change-me       # required outside local/test

# --- data stores
SP_DATABASE_URL=postgresql+asyncpg://storypanel:storypanel@localhost:5432/storypanel
SP_REDIS_URL=redis://localhost:6379/0
SP_S3_ENDPOINT_URL=http://localhost:9000      # omit for AWS S3
SP_S3_REGION=us-east-1
SP_S3_BUCKET=storypanel-assets
SP_S3_ACCESS_KEY_ID=
SP_S3_SECRET_ACCESS_KEY=

# --- Temporal (Temporal Cloud: set address, namespace, API key and SP_TEMPORAL_TLS=true)
SP_TEMPORAL_ADDRESS=localhost:7233
SP_TEMPORAL_NAMESPACE=default
SP_TEMPORAL_API_KEY=
SP_TEMPORAL_TLS=false

# --- auth: "dev" is refused in staging/production
SP_AUTH_MODE=dev                  # dev | clerk
SP_CLERK_ISSUER=                  # https://<your-instance>.clerk.accounts.dev
SP_CLERK_JWKS_URL=                # <issuer>/.well-known/jwks.json
SP_CLERK_AUTHORIZED_PARTIES=[]    # ["https://app.example.com"]
SP_CLERK_WEBHOOK_SECRET=
SP_CORS_ORIGINS=["http://localhost:3000"]

# --- providers: "fake" is refused in staging/production
SP_PROVIDER_MODE=fake             # fake | live
SP_ANTHROPIC_API_KEY=
SP_FAL_KEY=
SP_VOYAGE_API_KEY=
# Model identifiers have NO defaults. Live mode accepts only fal endpoints with a contract
# in providers/fal_profiles.py. Verified candidates (docs/providers.md):
#   text: claude-sonnet-5-5 (story), claude-haiku-5-5 (light, vision)
#   image: fal-ai/nano-banana-2, fal-ai/nano-banana-2/edit
#   fallback: fal-ai/bytedance/seedream/v5/lite/edit, .../text-to-image
#   inpaint: fal-ai/flux-pro/v1/fill   upscale: fal-ai/esrgan   embedding: voyage-multimodal-3.5
SP_TEXT_MODEL_STORY=
SP_TEXT_MODEL_LIGHT=
SP_VISION_MODEL=
SP_IMAGE_MODEL_GENERATE=
SP_IMAGE_MODEL_EDIT=
SP_IMAGE_MODEL_FALLBACK=          # edit fallback, used only while the primary's breaker is open
SP_IMAGE_MODEL_FALLBACK_GENERATE= # text-to-image fallback
SP_INPAINT_MODEL=                 # region repair; fal-ai/flux-pro/v1/fill has a verified contract
SP_UPSCALE_MODEL=
SP_EMBEDDING_MODEL=               # must accept images: voyage-multimodal-3.5
SP_EMBEDDING_DIMENSIONS=1024
# Provider prices: a JSON table with a source and verification date per model.
# Start from packages/pricing/pricing.example.json. Live mode refuses to start (and
# refuses billable calls) when a configured model has no entry, a zero price not marked
# "free", or an entry older than SP_PRICING_MAX_AGE_DAYS.
SP_PRICING_FILE=
SP_PRICING_JSON=                  # alternative to the file, for platforms without file mounts
SP_PRICING_MAX_AGE_DAYS=60
SP_COUNT_FAILED_REQUESTS_AS_BILLED=true
SP_SPEND_LIMIT_USER_DAILY_USD=10
SP_SPEND_LIMIT_PROJECT_USD=8
SP_SPEND_LIMIT_GLOBAL_DAILY_USD=500

# --- billing (Stripe)
SP_STRIPE_SECRET_KEY=
SP_STRIPE_WEBHOOK_SECRET=
SP_STRIPE_PRICE_CREATOR=
SP_STRIPE_PRICE_PRO=
SP_STRIPE_PRICE_CREDIT_PACK=
SP_WEB_BASE_URL=http://localhost:3000

# --- observability (all optional; generation never depends on them)
SP_OTLP_ENDPOINT=                 # http://otel-collector:4318
SP_TRACE_SAMPLE_RATIO=1.0
SP_SENTRY_DSN=
SP_LANGFUSE_PUBLIC_KEY=
SP_LANGFUSE_SECRET_KEY=
SP_LANGFUSE_HOST=
SP_LOG_PROMPTS=false              # keep false: raw prompts stay out of logs and traces

# --- web (compiled into the bundle at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_ASSET_ORIGINS=http://localhost:9000
NEXT_PUBLIC_SENTRY_DSN=
