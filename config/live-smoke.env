# Non-secret configuration for the first live comic (scripts/live-smoke.py). Secrets are NOT here:
# set SP_ANTHROPIC_API_KEY, SP_OPENAI_API_KEY and SP_GEMINI_API_KEY in an untracked .env
# (see docs/setup-checklist.md). fal and Voyage are not used and need no key.
SP_ENV=local
SP_AUTH_MODE=dev
SP_PROVIDER_MODE=live
# Anthropic: story, script, moderation, vision checks
SP_TEXT_MODEL_STORY=claude-sonnet-5-5
SP_TEXT_MODEL_LIGHT=claude-haiku-5-5
SP_VISION_MODEL=claude-haiku-5-5
# Images: OpenAI by default; Gemini selectable per comic (scripts/live-smoke.py run --image-provider)
SP_IMAGE_PROVIDERS='["openai", "gemini"]'
SP_IMAGE_PROVIDER_DEFAULT=openai
SP_OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
SP_OPENAI_IMAGE_QUALITY=medium
SP_GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
SP_GEMINI_IMAGE_SIZE=1K
SP_IMAGE_REQUEST_TIMEOUT_SECONDS=240
# Character consistency: Gemini compares each panel with the approved reference sheets
SP_IDENTITY_QA=gemini_visual
SP_GEMINI_QA_MODEL=gemini-3.8-flash
# Exports: native images, local resampling, effective-DPI warnings (no external upscaler)
SP_EXPORT_UPSCALE=local
SP_FAL_ENABLED=false
SP_VOYAGE_ENABLED=false
# Cost-bounding choices for this one smoke test (see docs/smoke-test-cost.md):
# - no server-side refusal fallback: a refused story call ends the run instead of a second billed call
SP_TEXT_REFUSAL_FALLBACK=false
# - the prompt names two characters (keeper, seagull); the bible may not add more reference sheets
SP_MAX_CHARACTERS=2
# Repair uses instruction edits plus local compositing (mask inpainting needs fal)
SP_REPAIR_MODE=reference_edit
SP_PRICING_FILE=packages/pricing/pricing.2026-11-14.json
SP_PRICING_MAX_AGE_DAYS=60
SP_COUNT_FAILED_REQUESTS_AS_BILLED=true
