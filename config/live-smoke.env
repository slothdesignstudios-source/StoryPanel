# Non-secret configuration for the first live comic (scripts/live-smoke.py). Secrets are NOT here:
# set SP_ANTHROPIC_API_KEY, SP_FAL_KEY and SP_VOYAGE_API_KEY in an untracked .env (see docs/setup-checklist.md).
SP_ENV=local
SP_AUTH_MODE=dev
SP_PROVIDER_MODE=live
SP_TEXT_MODEL_STORY=claude-sonnet-5-5
SP_TEXT_MODEL_LIGHT=claude-haiku-5-5
SP_VISION_MODEL=claude-haiku-5-5
SP_IMAGE_MODEL_GENERATE=fal-ai/nano-banana-2
SP_IMAGE_MODEL_EDIT=fal-ai/nano-banana-2/edit
SP_UPSCALE_MODEL=fal-ai/esrgan
SP_EMBEDDING_MODEL=voyage-multimodal-3.5
SP_EMBEDDING_DIMENSIONS=1024
# Cost-bounding choices for this one smoke test (models and scope unchanged; see docs/smoke-test-cost.md):
# - no server-side refusal fallback: a refused story call would otherwise be billed AND re-run on
#   claude-sonnet-5 (same price, but a second billed call the reservation does not hold). A refusal
#   ends the smoke run instead.
SP_TEXT_REFUSAL_FALLBACK=false
# - the prompt names two characters (keeper, seagull); the bible may not add more reference sheets
SP_MAX_CHARACTERS=2
# Optional paths left off for the smoke test: fallback models, mask inpainting (repair uses reference_edit).
SP_REPAIR_MODE=reference_edit
SP_PRICING_FILE=packages/pricing/pricing.2026-11-12.json
SP_PRICING_MAX_AGE_DAYS=60
SP_COUNT_FAILED_REQUESTS_AS_BILLED=true
